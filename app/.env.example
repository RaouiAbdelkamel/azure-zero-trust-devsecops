# Valeurs publiques seulement. Chargement explicite via --env-file en développement.
APP_ENV=development
APP_AUTH_ENABLED=false
APP_DOCS_ENABLED=false
APP_KEYVAULT_ENABLED=false
APP_WORKERS=1
APP_KEEP_ALIVE_SECONDS=5
APP_GRACEFUL_SHUTDOWN_SECONDS=20
APP_LIMIT_CONCURRENCY=100
APP_CORS_ORIGINS=[]
APP_HSTS_ENABLED=false
# Production : remplacer les identifiants publics puis activer l'authentification.
# APP_ENV=production
# APP_AUTH_ENABLED=true
# APP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# APP_ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
# APP_REQUIRED_SCOPES=["api.read"]
# APP_REQUIRED_ROLES=[]
# APP_KEYVAULT_ENABLED=true
# APP_KEYVAULT_URL=https://kv-ztprod-app-UNIQUE.vault.azure.net
# AZURE_CLIENT_ID, AZURE_TENANT_ID et AZURE_FEDERATED_TOKEN_FILE : injectés par AKS.
# Jamais AZURE_CLIENT_SECRET.
